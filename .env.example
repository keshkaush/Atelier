# Copy this file to .env and fill in your values, then restart `npm run dev`.

# --- OpenRouter (recommended: one key, many models, has free tiers) ---
# Get a key at https://openrouter.ai/keys  (free models still need a key)
VITE_AI_BASE_URL=https://openrouter.ai/api/v1
VITE_AI_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
VITE_AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional attribution (OpenRouter shows these on your usage page)
VITE_AI_APP_NAME=Atelier
# VITE_AI_APP_URL=https://your-site.example

# --- Any other OpenAI-compatible endpoint works the same way ---
# OpenAI:     VITE_AI_BASE_URL=https://api.openai.com/v1   VITE_AI_MODEL=gpt-4o-mini
# Groq:       VITE_AI_BASE_URL=https://api.groq.com/openai/v1
# Together:   VITE_AI_BASE_URL=https://api.together.xyz/v1
# Ollama:     VITE_AI_BASE_URL=http://localhost:11434/v1    VITE_AI_API_KEY=ollama  VITE_AI_MODEL=llama3.1
